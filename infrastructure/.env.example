# Infrastructure Config — Open Command
# Generated by Agent 1: Infrastructure Setup
#
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
#
# The AI assistant is Σ (Greek letter). Never "Sig" or "Sigma".

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Email Receiving — Cloudflare Email Routing
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Catch-all on bot.opencommand.co forwards to this Gmail
EMAIL_DOMAIN=bot.opencommand.co
EMAIL_FORWARD_TO=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Email Sending — Resend
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RESEND_API_KEY=re_xxxxx

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Messaging — Linq (iMessage + RCS + SMS)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LINQ_API_KEY=
LINQ_API_SECRET=
LINQ_SANDBOX_NUMBER=+1xxxxxxxxxx
LINQ_WEBHOOK_URL=https://your-server.com/webhook/linq/
# Rate limits: 50 new outbound/day/line, 200 ongoing/day/line, 1 msg/sec throughput
LINQ_RATE_LIMITS=50 new outbound/day/line, 200 ongoing/day/line

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DealBuilder Hosting — Cloudflare Pages
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DEALBUILDER_BASE_URL=https://deals.opencommand.co/deal
DEALBUILDER_DEPLOY_METHOD=cloudflare-pages

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Gmail API
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

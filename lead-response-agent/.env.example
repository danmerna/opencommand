# ──────────────────────────────────────────────
# Lead Response Agent — Environment Configuration
# ──────────────────────────────────────────────

# Gmail API OAuth credentials
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=credentials/gmail_token.pickle
GMAIL_LABEL=INBOX

# Linq API (primary iMessage deployment)
LINQ_API_KEY=
LINQ_API_URL=https://api.linq.ai/v1/messages
LINQ_FROM_NUMBER=+15551234567

# Twilio (fallback SMS deployment)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15559876543

# OpenRouter (LLM fallback for generic email parsing)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5

# DealBuilder page generation
DEALBUILDER_BASE_URL=https://deals.example.com
DEALBUILDER_OUTPUT_DIR=./dealbuilder_pages
DEALER_SLUG=acme-equipment

# Dealer info
DEALER_NAME=Acme Equipment Co.
DEALER_PHONE=+15555550100
DEALER_LOCATION=Springfield, MO

# Default salesperson
SALESPERSON_NAME=Jordan Miller
SALESPERSON_TITLE=Equipment Specialist
SALESPERSON_PHONE=+15555550101

# Webhook server
WEBHOOK_PORT=5000

# Scribe audit log path
SCRIBE_LOG_PATH=./verified_scribe.jsonl
